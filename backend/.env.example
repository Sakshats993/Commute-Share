# ==========================================================
# CommuteShare Backend Environment Configuration
# ==========================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------

APP_NAME=CommuteShare
APP_VERSION=1.0.0
DEBUG=True

# ----------------------------------------------------------
# API
# ----------------------------------------------------------

API_V1_PREFIX=/api

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/commuteshare

# ----------------------------------------------------------
# JWT Authentication
# ----------------------------------------------------------

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional Google/GitHub OAuth login. Leave blank to keep provider login disabled.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# Optional generic SMTP settings for password reset. Put account values in backend/.env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=False
SMTP_STARTTLS=True
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------

BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------

LOG_LEVEL=INFO

# ----------------------------------------------------------
# Optional Map Configuration
# ----------------------------------------------------------

MAP_DEFAULT_LATITUDE=13.3409
MAP_DEFAULT_LONGITUDE=74.7421
